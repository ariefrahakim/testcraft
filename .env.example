# ─────────────────────────────────────────────────────────────────────────────
# TestCraft Indonesia — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=testcraft
DB_PASSWORD=
DB_NAME=testcraft

# Full DATABASE_URL (used by Prisma in apps/api)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5433/${DB_NAME}?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── App URLs ──────────────────────────────────────────────────────────────────
# Public URLs used by the browser
NEXT_PUBLIC_API_URL=https://api.testcraft.id/api/v1
NEXT_PUBLIC_LMS_URL=https://app.testcraft.id
NEXT_PUBLIC_SITE_URL=https://testcraft.id

# Allowed CORS origins for the API
CORS_ORIGINS=https://app.testcraft.id,https://testcraft.id

# ── Payments (Midtrans) ───────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ── OAuth — Google (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Deployment ────────────────────────────────────────────────────────────────
# GitHub repository in owner/repo format (used to build ghcr.io image paths)
GITHUB_REPOSITORY=ariefrahakim/testcraft

# Docker image tag to deploy (set by CI to the git SHA, defaults to latest)
IMAGE_TAG=latest

# ── CI / GitHub Secrets (not needed locally) ─────────────────────────────────
# VPS_HOST=
# VPS_USER=deploy
# VPS_SSH_KEY=   (private key, multi-line, stored as a GitHub secret)
# VPS_PORT=22
