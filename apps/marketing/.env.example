# ─── App URLs ────────────────────────────────────────────────────────────────
# Where the "Login" and "Daftar" buttons link to (the LMS web app).
NEXT_PUBLIC_LMS_URL=http://localhost:3000

# The base URL of this marketing site. Used for SEO canonical URLs and meta tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The backend API URL. Used by the lead capture form to submit contact info.
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# ─── SEO ─────────────────────────────────────────────────────────────────────
# Site name used in page titles and Open Graph meta tags.
NEXT_PUBLIC_SITE_NAME=TestCraft Indonesia

# Default meta description for SEO.
NEXT_PUBLIC_SITE_DESCRIPTION=Pelatihan Software Testing & QA Engineering terbaik di Indonesia

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX).
# Leave empty to disable analytics tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
