# ─── API URLs ────────────────────────────────────────────────────────────────
# The URL that the browser uses when calling the API.
# NEXT_PUBLIC_ prefix means this value is visible in the browser (safe for API URLs).
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# The URL used by server-side code (Next.js Server Components and API routes).
# In Docker, this points to the API container's internal hostname.
# In production on the same server: http://api:4001/api/v1
API_INTERNAL_URL=http://localhost:4001/api/v1

# The base URL of this web app. Used for building absolute URLs (e.g., in emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to "true" to show the "Login with Google" button on the login page.
# Requires GOOGLE_CLIENT_ID to be configured in the API (.env).
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX).
# Leave empty to disable analytics tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
