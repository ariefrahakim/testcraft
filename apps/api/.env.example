# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001
API_PREFIX=api/v1
API_URL=http://localhost:4001
WEB_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS.
# In production: only your real domains (e.g., https://lms.testcraft.id)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker database (port 5433 to avoid conflicts with other Postgres)
DATABASE_URL="postgresql://testcraft:testcraft@localhost:5433/testcraft?schema=public"
# Separate test database for automated tests
TEST_DATABASE_URL="postgresql://testcraft:testcraft@localhost:5433/testcraft_test?schema=public"

# ─── Authentication (JWT) ────────────────────────────────────────────────────
# MUST be changed in production. Generate with: openssl rand -base64 48
# Both secrets must be different from each other.
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-use-different-value

# Access token validity: short because it is hard to revoke
JWT_ACCESS_TTL=15m
# Refresh token validity: longer because it is stored securely
JWT_REFRESH_TTL=30d

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Leave empty to disable Google login.
# Set up at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This URL must match exactly what is configured in Google OAuth settings
GOOGLE_CALLBACK_URL=http://localhost:4001/api/v1/auth/google/callback

# ─── File Storage ────────────────────────────────────────────────────────────
# Use "local" for development (files saved in /uploads folder).
# Use "s3" in production for reliable storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# AWS S3 settings (only needed when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Video Streaming (optional) ──────────────────────────────────────────────
# Cloudflare Stream API token for video uploads and playback
CF_STREAM_TOKEN=

# ─── Payments ────────────────────────────────────────────────────────────────
# Midtrans — Indonesian payment gateway (https://midtrans.com)
# Use sandbox keys for development, live keys for production
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set to false in production to use real payments
MIDTRANS_SANDBOX=true

# Xendit — Alternative payment gateway (optional)
XENDIT_SECRET_KEY=

# Stripe — International payments (optional)
STRIPE_SECRET_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Resend API key for sending transactional emails (https://resend.com)
RESEND_API_KEY=
# The sender address for all outgoing emails.
# Must be quoted because "#" is treated as a comment by dotenv.
EMAIL_FROM="TestCraft <no-reply@testcraft.id>"

# ─── Admin Seed Account ──────────────────────────────────────────────────────
# These credentials are used when running: npm run db:seed
# The password MUST be quoted because "#" is treated as a comment by dotenv.
# Change the password immediately after first login in production.
SEED_ADMIN_EMAIL=admin@testcraft.id
SEED_ADMIN_PASSWORD="Admin#12345"
