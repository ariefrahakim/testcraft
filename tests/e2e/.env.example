# ─── App URLs ────────────────────────────────────────────────────────────────
# The LMS web app URL. All student/admin tests run against this.
BASE_URL=http://localhost:3000

# The marketing site URL. Landing page tests run against this.
MARKETING_URL=http://localhost:3001

# The backend API URL. Used for direct API calls in tests (health checks, setup/teardown).
API_URL=http://localhost:4001/api/v1

# ─── Test Accounts ───────────────────────────────────────────────────────────
# These accounts are created by running: npm run db:seed (from the project root).
# Do NOT use real production accounts here.

# Admin account — has access to all admin pages and APIs
ADMIN_EMAIL=admin@testcraft.id
ADMIN_PASSWORD=Admin#12345

# Student account — for testing the learning experience
STUDENT_EMAIL=student@testcraft.id
STUDENT_PASSWORD=Student#12345

# Instructor account — for testing course management and grading
INSTRUCTOR_EMAIL=instructor@testcraft.id
INSTRUCTOR_PASSWORD=Instructor#12345

# ─── Qase Integration (optional) ─────────────────────────────────────────────
# For uploading test results to Qase test management platform.
# Leave empty to skip Qase reporting (tests still run, results just aren't uploaded).
# Get your token from: https://app.qase.io/user/api/token
QASE_TOKEN=
# The project code in Qase (e.g., "TC" for TestCraft)
QASE_PROJECT=TC
# The title for each test run in Qase
QASE_RUN_TITLE=E2E Test Run

# ─── Browser Options ─────────────────────────────────────────────────────────
# Set to "false" to see the browser window while tests run (useful for debugging)
HEADLESS=true
# Milliseconds to slow down each action. 0 = full speed. 500 = half-second pauses.
# Useful when set to 500-1000 to watch tests run slowly.
SLOW_MO=0
